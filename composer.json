{
    "name": "roundly-consulting/permissions-for-laravel",
    "description": "Native roles & permissions for Laravel — single-guard, cache-backed, additive-grant registry with Gate integration and zero third-party runtime deps.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "permissions",
        "roles",
        "authorization",
        "acl"
    ],
    "homepage": "https://github.com/roundly-consulting/permissions-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Permissions\\": "src/",
            "RoundlyConsulting\\Permissions\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Permissions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Permissions\\PermissionsServiceProvider"
            ],
            "aliases": {
                "Permissions": "RoundlyConsulting\\Permissions\\Facades\\Permissions"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
